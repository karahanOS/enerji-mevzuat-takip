# =====================================================================
# Enerji Mevzuat Takibi – ortam değişkenleri (tümü ücretsiz servisler)
# Yerelde: bu dosyayı .env olarak kopyalayıp doldurun (.env git'e eklenmez).
# GitHub Actions'ta: aynı adlarla depo Settings → Secrets and variables → Actions.
# =====================================================================

# ---- E-posta: Gmail SMTP (ücretsiz) -----------------------------------
# Google hesabında 2 Adımlı Doğrulama açık olmalı; "Uygulama şifreleri"nden 16 haneli şifre alın.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# Boş bırakılırsa SMTP_USERNAME kullanılır
EMAIL_FROM=
# Virgülle ayrılmış alıcılar (genellikle kendi adresiniz)
EMAIL_TO=
EMAIL_CC=
# Sistem uyarıları (boşsa EMAIL_TO'ya gider)
ADMIN_EMAIL=
SEND_EMPTY_REPORTS=true
NOTIFY_RECIPIENTS_ON_FAILURE=true

# ---- Yapay zekâ (yalnızca ücretsiz seçenekler) -------------------------
# Gemini API anahtarı: https://aistudio.google.com → "Get API key" (kart gerektirmez)
GEMINI_API_KEY=
# Groq API anahtarı: https://console.groq.com/keys (ücretsiz plan)
GROQ_API_KEY=
# Sıralı yedekleme zincirleri "sağlayıcı:model" biçiminde. Kota dolarsa sıradakine geçilir.
# Anahtarı tanımlı olmayan sağlayıcılar otomatik atlanır. AI'yı kapatmak için: none
LLM_ANALYSIS_CHAIN=gemini:gemini-3.8-flash,gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-120b
LLM_TRIAGE_CHAIN=gemini:gemini-3.5-flash-lite,groq:openai/gpt-oss-20b
# Yerel Ollama kullanmak için (bilgisayar açık olmalı), ör.:
# LLM_ANALYSIS_CHAIN=ollama:qwen2.5:14b
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Ücretsiz kotayı aşmamak için kendi koyduğunuz günlük tavan (analiz + ön eleme çağrıları)
LLM_DAILY_MAX_CALLS=40
# Sağlayıcı başına metin sınırı (Groq ücretsiz katmanı dakikada ~8.000 token sınırlı)
GEMINI_MAX_INPUT_CHARS=60000
GROQ_MAX_INPUT_CHARS=12000
OLLAMA_MAX_INPUT_CHARS=12000
LLM_TRIAGE_UNCERTAIN=true

# ---- Zamanlama ve veri -------------------------------------------------
TIMEZONE=Europe/Istanbul
DAILY_REPORT_TIME=08:00
DATABASE_URL=sqlite:///data/enerji_takip.db
REPORT_DIR=data/raporlar
LOG_DIR=data/loglar
REPORT_KEEP=60
# Raporda "kontrol için elenen belgeler" listesinin en fazla uzunluğu (0 = listeleme)
REPORT_EXCLUDED_MAX=150

# ---- Tarama ------------------------------------------------------------
# Siteler sizi bu adla tanır; bir iletişim adresi yazmanız önerilir.
HTTP_USER_AGENT=enerji-mevzuat-takip/0.1 (iletisim: adresiniz@ornek.com)
HTTP_MIN_INTERVAL_SECONDS=1.5
RESPECT_ROBOTS_TXT=true
RG_RESCAN_DAYS=2
RG_MAX_BACKFILL_DAYS=14
RG_FIRST_RUN_DAYS=1

# Metin katmanı bozuk PDF'ler (EPDK kararları) için OCR; pdftoppm ve tesseract kuruluysa çalışır
OCR_ENABLED=true
OCR_MAX_PAGES=8

LOG_LEVEL=INFO
