<!DOCTYPE html>
<html lang="tr">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ subject }}</title></head>
<body style="margin:0;padding:0;background:#f2f4f7;font-family:Segoe UI,Arial,Helvetica,sans-serif;color:#101828;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f2f4f7;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:760px;background:#ffffff;border:1px solid #e4e7ec;border-radius:8px;">
<tr><td style="padding:24px 28px 8px 28px;">
  <div style="font-size:12px;letter-spacing:.08em;color:#667085;text-transform:uppercase;">Enerji Mevzuat Takibi</div>
  <h1 style="margin:6px 0 4px 0;font-size:22px;line-height:1.3;">{% if report_type == 'kritik' %}Kritik Enerji Mevzuatı Bildirimi{% else %}Günlük Enerji Mevzuatı Raporu{% endif %}</h1>
</td></tr>

<tr><td style="padding:8px 28px 4px 28px;">
  <table role="presentation" cellspacing="0" cellpadding="0" style="font-size:14px;line-height:1.7;">
    <tr><td style="color:#475467;padding-right:12px;">Rapor tarihi:</td><td><strong>{{ report_date }}</strong></td></tr>
    <tr><td style="color:#475467;padding-right:12px;">Tarama dönemi:</td><td>{{ period_start }} – {{ period_end }}</td></tr>
    <tr><td style="color:#475467;padding-right:12px;">Tespit edilen yeni düzenleme:</td><td><strong>{{ total }}</strong>{% if routine_count %} <span style="color:#667085;">(+ {{ routine_count }} rutin kurul kararı)</span>{% endif %}</td></tr>
    <tr><td style="color:#475467;padding-right:12px;">Kritik / Yüksek:</td><td><strong style="color:{{ level_colors['KRITIK'] }};">{{ critical }}</strong> / <strong style="color:{{ level_colors['YUKSEK'] }};">{{ high }}</strong></td></tr>
    <tr><td style="color:#475467;padding-right:12px;">Orta / Düşük:</td><td>{{ medium }} / {{ low }}{% if review_count %} &nbsp;·&nbsp; İnceleme gereken: {{ review_count }}{% endif %}</td></tr>
  </table>
</td></tr>

{% if not is_complete %}
<tr><td style="padding:12px 28px;">
  <div style="border:1px solid #fda29b;background:#fef3f2;border-radius:6px;padding:12px 14px;font-size:14px;line-height:1.55;">
    <strong style="color:#b42318;">⚠ Tarama eksik tamamlandı.</strong> Aşağıdaki kaynak veya günler kontrol edilemedi; bu raporda
    yer almayan değişiklikler olabilir. Eksik dönem bir sonraki çalıştırmada otomatik olarak yeniden taranacaktır.
    <ul style="margin:8px 0 0 18px;padding:0;">{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
</td></tr>
{% elif warnings %}
<tr><td style="padding:8px 28px;">
  <div style="border:1px solid #fedf89;background:#fffaeb;border-radius:6px;padding:10px 14px;font-size:13px;line-height:1.5;">
    <strong>Notlar:</strong>
    <ul style="margin:6px 0 0 18px;padding:0;">{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
</td></tr>
{% endif %}

{% if total == 0 and routine_count == 0 %}
<tr><td style="padding:12px 28px;">
  <div style="border:1px solid #abefc6;background:#ecfdf3;border-radius:6px;padding:12px 14px;font-size:14px;line-height:1.55;">
    {% if is_complete %}Bu tarama döneminde enerji sektörüyle ilgili yeni bir düzenleme tespit edilmedi.{% else %}Taranabilen kaynaklarda yeni bir düzenleme bulunmadı; ancak tarama eksik olduğundan bu sonuç kesin değildir.{% endif %}
    Taranan belge: {{ docs_scanned }} · İlgisiz bulunan: {{ docs_filtered }} · Analiz dışı (ilan vb.): {{ docs_skipped }}
  </div>
</td></tr>
{% endif %}

{% for it in items %}
<tr><td style="padding:16px 28px 4px 28px;">
  <div style="border:1px solid #e4e7ec;border-left:5px solid {{ it.importance_color }};border-radius:6px;padding:16px 18px;">
    <div style="margin-bottom:6px;">
      <span style="display:inline-block;background:{{ it.importance_color }};color:#ffffff;font-size:12px;font-weight:700;letter-spacing:.04em;padding:2px 8px;border-radius:4px;">{{ it.importance }}</span>
      {% if it.needs_review %}<span style="display:inline-block;background:#fffaeb;color:#b54708;border:1px solid #fedf89;font-size:12px;padding:1px 7px;border-radius:4px;margin-left:6px;">Kontrol et</span>{% endif %}
    </div>
    <h2 style="margin:0 0 10px 0;font-size:17px;line-height:1.4;">{{ it.n }}. {{ it.title }}</h2>
    <table role="presentation" cellspacing="0" cellpadding="0" style="font-size:13.5px;line-height:1.65;width:100%;">
      <tr><td style="color:#475467;width:190px;vertical-align:top;">Mevzuatın türü:</td><td>{{ it.doc_type }} — {{ it.change_type }}{% if it.institution %} <span style="color:#667085;">({{ it.institution }})</span>{% endif %}</td></tr>
      <tr><td style="color:#475467;vertical-align:top;">Resmî Gazete tarihi ve sayısı:</td><td>{{ it.rg or 'Resmî Gazete dışı kaynak (' ~ it.source_name ~ ')' }}</td></tr>
      <tr><td style="color:#475467;vertical-align:top;">Yayımlanma tarihi:</td><td>{{ it.published }}</td></tr>
      <tr><td style="color:#475467;vertical-align:top;">Yürürlük tarihi:</td><td>{% for e in it.effective %}{{ e }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% if it.effective_note %}<br><span style="color:#667085;">{{ it.effective_note }}</span>{% endif %}</td></tr>
      {% if it.aspects %}<tr><td style="color:#475467;vertical-align:top;">Değişikliğin niteliği:</td><td>{{ it.aspects | join(', ') }}</td></tr>{% endif %}
      <tr><td style="color:#475467;vertical-align:top;">Önem seviyesi:</td><td><strong style="color:{{ it.importance_color }};">{{ it.importance }}</strong></td></tr>
      <tr><td style="color:#475467;vertical-align:top;">İlgili alanlar:</td><td>{{ it.areas | join(', ') }}</td></tr>
      {% if it.market_items %}<tr><td style="color:#475467;vertical-align:top;">Etkilenen piyasa unsurları:</td><td>{{ it.market_items | join(', ') }}</td></tr>{% endif %}
      {% if it.who %}<tr><td style="color:#475467;vertical-align:top;">Kimler etkilenir:</td><td>{{ it.who | join(', ') }}</td></tr>{% endif %}
      {% if it.amended %}<tr><td style="color:#475467;vertical-align:top;">Değiştirilen mevzuat:</td><td>{{ it.amended }}{% if it.amended_ref %} <span style="color:#667085;">({{ it.amended_ref }})</span>{% endif %}</td></tr>{% endif %}
      {% if it.articles %}<tr><td style="color:#475467;vertical-align:top;">İlgili maddeler:</td><td>{{ it.articles | join('; ') }}</td></tr>{% endif %}
    </table>

    <h3 style="font-size:14px;margin:14px 0 4px 0;">Değişikliğin özeti</h3>
    <p style="margin:0;font-size:14px;line-height:1.6;">{{ it.summary }}</p>

    <h3 style="font-size:14px;margin:14px 0 4px 0;">Piyasaya etkisi <span style="font-weight:400;color:#667085;">({{ it.impact_level }})</span></h3>
    <p style="margin:0;font-size:14px;line-height:1.6;">{{ it.impact }}</p>
    {% if it.personal %}
    <h3 style="font-size:14px;margin:14px 0 4px 0;">Benim açımdan önemi</h3>
    <p style="margin:0;font-size:14px;line-height:1.6;">{{ it.personal }}</p>
    {% endif %}

    {% if it.provisions %}
    <h3 style="font-size:14px;margin:14px 0 4px 0;">Mevzuatta açıkça yer alan hükümler</h3>
    <ul style="margin:0 0 0 18px;padding:0;font-size:13.5px;line-height:1.55;">
      {% for p in it.provisions %}<li>{{ p.hukum }}{% if p.madde %} <span style="color:#667085;">[{{ p.madde }}]</span>{% endif %}{% if p.alinti %}<br><span style="color:#475467;font-style:italic;">“{{ p.alinti }}”</span>{% endif %}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if it.inferences %}
    <h3 style="font-size:14px;margin:14px 0 4px 0;">Yapay zekâ çıkarımları <span style="font-weight:400;color:#667085;">(mevzuatta açıkça yazmaz; yorumdur)</span></h3>
    <ul style="margin:0 0 0 18px;padding:0;font-size:13.5px;line-height:1.55;color:#344054;">
      {% for x in it.inferences %}<li>{{ x }}</li>{% endfor %}
    </ul>
    {% endif %}

    <h3 style="font-size:14px;margin:14px 0 4px 0;">Takip önerileri</h3>
    <ul style="margin:0 0 0 18px;padding:0;font-size:14px;line-height:1.6;">
      {% for a in it.actions %}<li>{{ a }}</li>{% endfor %}
    </ul>

    <h3 style="font-size:14px;margin:14px 0 4px 0;">Uyum / geçiş tarihleri</h3>
    <p style="margin:0;font-size:14px;line-height:1.6;">
      {% if it.compliance %}{% for c in it.compliance %}{{ c }}{% if not loop.last %}<br>{% endif %}{% endfor %}{% else %}Ayrı bir uyum süresi tespit edilmedi; yürürlük tarihi esas alınmalıdır.{% endif %}
    </p>

    <h3 style="font-size:14px;margin:14px 0 4px 0;">Resmî kaynak</h3>
    <p style="margin:0;font-size:14px;line-height:1.6;word-break:break-all;">
      <a href="{{ it.url }}" style="color:#175cd3;">{{ it.url }}</a>{% if not it.url_verified %} <span style="color:#b54708;">(bağlantı içeriği doğrulanamadı)</span>{% endif %}
      {% if it.pdf_url %}<br>PDF: <a href="{{ it.pdf_url }}" style="color:#175cd3;">{{ it.pdf_url }}</a>{% endif %}
    </p>

    {% if it.needs_review %}
    <div style="margin-top:12px;border:1px solid #fedf89;background:#fffaeb;border-radius:6px;padding:8px 12px;font-size:12.5px;line-height:1.5;color:#7a2e0e;">
      <strong>Neden kontrol etmelisin:</strong>
      <ul style="margin:4px 0 0 16px;padding:0;">{% for r in it.review_reasons %}<li>{{ r }}</li>{% endfor %}</ul>
    </div>
    {% endif %}
    <div style="margin-top:8px;font-size:11.5px;color:#667085;line-height:1.45;">Önem gerekçesi: {{ it.importance_reasons | join(' · ') }}{% if it.ai_model %} · Model: {{ it.ai_model }}{% endif %}</div>
  </div>
</td></tr>
{% endfor %}

{% if routine %}
<tr><td style="padding:18px 28px 4px 28px;">
  <h3 style="font-size:14px;margin:0 0 6px 0;">Rutin kurul kararları ({{ routine|length }})</h3>
  <p style="font-size:12px;color:#667085;margin:0 0 8px 0;">Tek şirkete/tesise özgü kararlar (lisans tadili, süre uzatımı vb.). AI kotası harcanmaz; yalnızca listelenir.</p>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:12.5px;line-height:1.5;border-collapse:collapse;">
    {% for r in routine %}
    <tr><td style="padding:6px;border-bottom:1px solid #f2f4f7;vertical-align:top;">
      <a href="{{ r.url }}" style="color:#175cd3;">{{ r.title }}</a> <span style="color:#667085;">({{ r.rg }})</span>
      {% if r.gist %}<br><span style="color:#475467;">{{ r.gist }}</span>{% endif %}
    </td></tr>
    {% endfor %}
  </table>
</td></tr>
{% endif %}

{% if sources %}
<tr><td style="padding:18px 28px 6px 28px;">
  <h3 style="font-size:14px;margin:0 0 6px 0;">Kaynak durumu</h3>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:12.5px;line-height:1.5;border-collapse:collapse;">
    <tr style="background:#f9fafb;color:#475467;"><td style="padding:6px;border-bottom:1px solid #e4e7ec;">Kaynak</td><td style="padding:6px;border-bottom:1px solid #e4e7ec;">Durum</td><td style="padding:6px;border-bottom:1px solid #e4e7ec;">Son başarılı kontrol</td></tr>
    {% for s in sources %}
    <tr><td style="padding:6px;border-bottom:1px solid #f2f4f7;">{{ s.name }}</td>
        <td style="padding:6px;border-bottom:1px solid #f2f4f7;color:{{ '#667085' if s.disabled else '#067647' if s.ok else '#b42318' }};">{{ s.status }}{% if s.detail %}<br><span style="color:#667085;">{{ s.detail }}</span>{% endif %}</td>
        <td style="padding:6px;border-bottom:1px solid #f2f4f7;">{{ s.last_success }}</td></tr>
    {% endfor %}
  </table>
  <p style="font-size:12px;color:#667085;margin:6px 0 0 0;">Bu dönemde taranan belge: {{ docs_scanned }} · ilgisiz bulunarak filtrelenen: {{ docs_filtered }} · analiz dışı: {{ docs_skipped }}{% if ai_usage %} · bugünkü AI çağrısı: {{ ai_usage }}{% endif %}</p>
</td></tr>
{% endif %}

{% if excluded.irrelevant or excluded.skipped or excluded.skipped_relevant %}
<tr><td style="padding:18px 28px 6px 28px;">
  <h3 style="font-size:14px;margin:0 0 4px 0;">Kontrol için: elenen belgeler</h3>
  <p style="font-size:12px;color:#667085;margin:0 0 8px 0;">Bu taramada ilk kez görülen ve analiz edilmeyen belgeler. Yanlışlıkla elenmiş ilgili bir düzenleme görürseniz bağlantıdan açıp kontrol edin.</p>
  {% for key, label in (("skipped_relevant", "Analiz dışı bırakıldı ama enerjiyle ilgili görünüyor — lütfen kontrol edin"), ("irrelevant", "İlgisiz bulundu"), ("skipped", "Analiz dışı (ilan vb.)")) %}
  {% set docs = excluded[key] %}
  {% if docs %}
  <p style="font-size:12.5px;font-weight:600;margin:10px 0 4px 0;{% if key == 'skipped_relevant' %}color:#b54708;{% endif %}">{{ label }} ({{ excluded[key ~ "_total"] }})</p>
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="font-size:12px;line-height:1.45;border-collapse:collapse;">
    {% for d in docs %}
    <tr><td style="padding:4px 6px;border-bottom:1px solid #f2f4f7;vertical-align:top;">
      <a href="{{ d.url }}" style="color:#175cd3;">{{ d.title }}</a>
      <span style="color:#667085;"> — {{ d.source }}{% if d.date %}, {{ d.date }}{% endif %}{% if d.reason and key == "irrelevant" %} · {{ d.reason }}{% elif d.section %} · {{ d.section }}{% endif %}{% if d.keywords %} · eşleşen: {{ d.keywords|join(", ") }}{% endif %}</span>
    </td></tr>
    {% endfor %}
  </table>
  {% if excluded[key ~ "_total"] > docs|length %}<p style="font-size:12px;color:#667085;margin:4px 0 0 0;">… ve {{ excluded[key ~ "_total"] - docs|length }} belge daha (listeyi uzatmak için REPORT_EXCLUDED_MAX).</p>{% endif %}
  {% endif %}
  {% endfor %}
</td></tr>
{% endif %}

<tr><td style="padding:16px 28px 24px 28px;">
  <p style="font-size:11.5px;line-height:1.55;color:#667085;margin:0;border-top:1px solid #e4e7ec;padding-top:12px;">{{ disclaimer }}</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
